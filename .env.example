# ShaadiSetGo - Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================================
# Supabase Configuration (Required for Database)
# ============================================================
# Get these from: Supabase Dashboard → Project Settings → API

# Public URL (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon Key - for client-side operations (Required)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key - for backend/admin operations (REQUIRED!)
# ⚠️ Keep this secret! Never expose in client-side code
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================
# Admin Password (for admin dashboard access)
# ============================================================
ADMIN_PASSWORD=your_admin_password

# ============================================================
# Optional Configuration
# ============================================================
# NEXT_PUBLIC_APP_URL=https://your-app-name.vercel.app
